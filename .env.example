# Target environment. Defaults to the Shiftbase demo environment when unset.
BASE_URL=https://app.sb036c506.demo.shiftbase.co

# Optional: an existing Shiftbase trial account for the login specs.
# When these are absent the suite mints its own account by running the
# signup flow first, so a clean clone still runs green.
SB_EMAIL=
SB_PASSWORD=

# Optional: mailbox root used to derive unique plus-addressed signup
# recipients (e.g. you@example.com -> you+sb-<run>@example.com).
SB_SIGNUP_EMAIL_ROOT=
