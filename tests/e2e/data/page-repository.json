{
  "pages": [
    {
      "name": "SignupPage",
      "elements": [
        {
          "elementName": "heading",
          "selector": {
            "role": "heading",
            "name": {
              "regex": "Let's get started for free",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "firstName",
          "selector": {
            "role": "textbox",
            "name": "First name"
          }
        },
        {
          "elementName": "lastName",
          "selector": {
            "role": "textbox",
            "name": "Last name"
          }
        },
        {
          "elementName": "email",
          "selector": {
            "role": "textbox",
            "name": "Your business email"
          }
        },
        {
          "elementName": "mobileNumber",
          "selector": {
            "role": "textbox",
            "name": "Your mobile number"
          }
        },
        {
          "elementName": "password",
          "selector": {
            "role": "textbox",
            "name": "Password"
          }
        },
        {
          "elementName": "termsCheckbox",
          "selector": {
            "role": "checkbox",
            "name": {
              "regex": "I accept the terms",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "getStartedButton",
          "selector": {
            "role": "button",
            "name": "Get started"
          }
        },
        {
          "elementName": "loginLink",
          "selector": {
            "role": "link",
            "name": "Log in"
          }
        },
        {
          "elementName": "emailInvalidError",
          "selector": {
            "text": "Invalid email"
          }
        },
        {
          "elementName": "phoneInvalidError",
          "selector": {
            "text": "Telephone number is invalid"
          }
        },
        {
          "elementName": "passwordUnmetRequirement",
          "selector": {
            "css": "sb-password-input-requirements sb-icon[aria-label='exclamation-circle']"
          }
        }
      ]
    },
    {
      "name": "SignupQuestionnairePage",
      "elements": [
        {
          "elementName": "businessName",
          "selector": {
            "css": "input[formcontrolname='company']"
          }
        },
        {
          "elementName": "numberOfEmployees",
          "selector": {
            "role": "spinbutton",
            "name": "Number of employees"
          }
        },
        {
          "elementName": "nextButton",
          "selector": {
            "role": "button",
            "name": "Next"
          }
        },
        {
          "elementName": "progressBar",
          "selector": {
            "role": "progressbar"
          }
        },
        {
          "elementName": "businessTypeOption",
          "selector": {
            "css": "[formcontrolname='industry_group'] input[value='Services'] + label"
          }
        },
        {
          "elementName": "industryOption",
          "selector": {
            "css": "[formcontrolname='industry'] input[value='Consulting'] + label"
          }
        },
        {
          "elementName": "buyerRoleOption",
          "selector": {
            "css": "[formcontrolname='buyer_role'] input[value='Operation manager'] + label"
          }
        },
        {
          "elementName": "needSchedulingOption",
          "selector": {
            "css": "[formcontrolname='buyer_intent'] input[value='intent_schedule'] + label"
          }
        },
        {
          "elementName": "needTimeTrackingOption",
          "selector": {
            "css": "[formcontrolname='buyer_intent'] input[value='intent_timetracking'] + label"
          }
        },
        {
          "elementName": "needsCheckedOption",
          "selector": {
            "css": "[formcontrolname='buyer_intent'] input:checked"
          }
        },
        {
          "elementName": "situationOption",
          "selector": {
            "css": "[formcontrolname='situation'] input[value='situation_spreadsheets'] + label"
          }
        },
        {
          "elementName": "painOption",
          "selector": {
            "css": "[formcontrolname='pain'] input[value='pain_scheduling_takes_too_much_time'] + label"
          }
        },
        {
          "elementName": "impactOption",
          "selector": {
            "css": "[formcontrolname='impact'] input[value='impact_time_wasted_scheduling'] + label"
          }
        },
        {
          "elementName": "criticalEventOption",
          "selector": {
            "css": "[formcontrolname='critical_event'] input[value='critical_event_rapid_growth'] + label"
          }
        },
        {
          "elementName": "urgencyOption",
          "selector": {
            "css": "[formcontrolname='intent_urgency'] input[value='exploring'] + label"
          }
        }
      ]
    },
    {
      "name": "OnboardingPage",
      "elements": [
        {
          "elementName": "nextButton",
          "selector": {
            "role": "button",
            "name": "Next"
          }
        },
        {
          "elementName": "skipButton",
          "selector": {
            "role": "button",
            "name": "Skip"
          }
        },
        {
          "elementName": "allSetHeading",
          "selector": {
            "role": "heading",
            "name": {
              "regex": "You're all set",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "seeInActionButton",
          "selector": {
            "role": "button",
            "name": {
              "regex": "See Shiftbase in action",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "progressBar",
          "selector": {
            "role": "progressbar"
          }
        },
        {
          "elementName": "teamsHeading",
          "selector": {
            "role": "heading",
            "name": {
              "regex": "Organise your teams",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "teamNameInput",
          "selector": {
            "css": "input[name='name']"
          }
        },
        {
          "elementName": "addTeamButton",
          "selector": {
            "role": "button",
            "name": "Add team"
          }
        },
        {
          "elementName": "employeesHeading",
          "selector": {
            "role": "heading",
            "name": {
              "regex": "add your first employees",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "employeeFirstName",
          "selector": {
            "css": "input[name='first_name']"
          }
        },
        {
          "elementName": "employeeLastName",
          "selector": {
            "css": "input[name='last_name']"
          }
        },
        {
          "elementName": "employeeTeamSelect",
          "selector": {
            "css": "select[name='Team']"
          }
        },
        {
          "elementName": "employeeTeamOption",
          "selector": {
            "css": "select[name='Team'] option"
          }
        },
        {
          "elementName": "addEmployeeButton",
          "selector": {
            "role": "button",
            "name": "Add employee"
          }
        },
        {
          "elementName": "shiftTemplatesHeading",
          "selector": {
            "role": "heading",
            "name": {
              "regex": "Shift templates",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "shiftTemplateName",
          "selector": {
            "css": "input[name='long_name']"
          }
        },
        {
          "elementName": "shiftTemplateStart",
          "selector": {
            "css": "input[name='starttime']"
          }
        },
        {
          "elementName": "shiftTemplateEnd",
          "selector": {
            "css": "input[name='endtime']"
          }
        },
        {
          "elementName": "addShiftTemplateButton",
          "selector": {
            "role": "button",
            "name": "Add Shift template"
          }
        }
      ]
    },
    {
      "name": "LoginPage",
      "elements": [
        {
          "elementName": "heading",
          "selector": {
            "role": "heading",
            "name": "Welcome back"
          }
        },
        {
          "elementName": "email",
          "selector": {
            "role": "textbox",
            "name": "Email address"
          }
        },
        {
          "elementName": "password",
          "selector": {
            "role": "textbox",
            "name": "Password"
          }
        },
        {
          "elementName": "loginButton",
          "selector": {
            "role": "button",
            "name": "Log in"
          }
        },
        {
          "elementName": "errorAlert",
          "selector": {
            "role": "alert"
          }
        },
        {
          "elementName": "emailRequiredError",
          "selector": {
            "text": "Email is required"
          }
        },
        {
          "elementName": "passwordRequiredError",
          "selector": {
            "text": "Password is required"
          }
        },
        {
          "elementName": "keepLoggedInCheckbox",
          "selector": {
            "role": "checkbox",
            "name": "Keep me logged in"
          }
        },
        {
          "elementName": "forgotPasswordLink",
          "selector": {
            "role": "link",
            "name": "Forgot password?"
          }
        }
      ]
    },
    {
      "name": "MfaPromotePage",
      "elements": [
        {
          "elementName": "heading",
          "selector": {
            "role": "heading",
            "name": "Multifactor authentication"
          }
        },
        {
          "elementName": "setUpNowButton",
          "selector": {
            "role": "button",
            "name": "Set up now"
          }
        },
        {
          "elementName": "remindMeLaterButton",
          "selector": {
            "role": "button",
            "name": "Remind me later"
          }
        },
        {
          "elementName": "dontAskAgainButton",
          "selector": {
            "role": "button",
            "name": {
              "regex": "Don.t ask again",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "backToLoginButton",
          "selector": {
            "role": "button",
            "name": "Back to login"
          }
        }
      ]
    },
    {
      "name": "DashboardPage",
      "elements": [
        {
          "elementName": "homeNavLink",
          "selector": {
            "role": "link",
            "name": {
              "regex": "^(Home|Dashboard)$",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "scheduleNavLink",
          "selector": {
            "role": "link",
            "name": "Schedule"
          }
        },
        {
          "elementName": "timesheetNavLink",
          "selector": {
            "role": "link",
            "name": "Timesheet"
          }
        },
        {
          "elementName": "employeesNavLink",
          "selector": {
            "role": "link",
            "name": "Employees"
          }
        },
        {
          "elementName": "reportsNavLink",
          "selector": {
            "role": "link",
            "name": "Reports"
          }
        },
        {
          "elementName": "mySchedulePanel",
          "selector": {
            "role": "heading",
            "name": "My schedule"
          }
        },
        {
          "elementName": "myTimesheetsPanel",
          "selector": {
            "role": "heading",
            "name": "My timesheets"
          }
        },
        {
          "elementName": "firstRunDialog",
          "selector": {
            "role": "dialog"
          }
        },
        {
          "elementName": "firstRunDialogClose",
          "selector": {
            "css": "[role='dialog'] button[aria-label='Close'], [role='dialog'] button:has-text('Close')"
          }
        },
        {
          "elementName": "addWorkedHoursButton",
          "selector": {
            "role": "button",
            "name": "Add Worked Hours"
          }
        }
      ]
    },
    {
      "name": "ChecklistPage",
      "elements": [
        {
          "elementName": "widget",
          "selector": {
            "css": "my-checklist-widget"
          }
        },
        {
          "elementName": "widgetProgress",
          "selector": {
            "css": "my-checklist-widget [role='progressbar']"
          }
        },
        {
          "elementName": "widgetEncouragement",
          "selector": {
            "css": "my-checklist-widget sb-checklist-content > div p"
          }
        },
        {
          "elementName": "tasks",
          "selector": {
            "css": "my-checklist-widget sb-checklist-item"
          }
        },
        {
          "elementName": "taskHeader",
          "selector": {
            "css": "section > div"
          }
        },
        {
          "elementName": "taskTitle",
          "selector": {
            "css": "section > div > p"
          }
        },
        {
          "elementName": "taskDescription",
          "selector": {
            "css": "article p"
          }
        },
        {
          "elementName": "taskStartButton",
          "selector": {
            "css": "article button:has-text('Start')"
          }
        },
        {
          "elementName": "taskShowMeButton",
          "selector": {
            "css": "article button:has-text('Show me')"
          }
        },
        {
          "elementName": "completedTasks",
          "selector": {
            "css": "my-checklist-widget sb-checklist-item:has(sb-icon[aria-label='check-circle-solid'])"
          }
        },
        {
          "elementName": "expandedTasks",
          "selector": {
            "css": "my-checklist-widget sb-checklist-item[aria-expanded='true']"
          }
        },
        {
          "elementName": "dismissButton",
          "selector": {
            "css": "my-checklist-widget button:has-text('Dismiss checklist')"
          }
        },
        {
          "elementName": "sidebarEntry",
          "selector": {
            "css": "app-side-panel-trigger, li:has(> div > span:text-is('Get started'))"
          }
        },
        {
          "elementName": "panel",
          "selector": {
            "css": "checklist-panel"
          }
        },
        {
          "elementName": "panelHeading",
          "selector": {
            "role": "heading",
            "name": "Get started"
          }
        },
        {
          "elementName": "panelTasks",
          "selector": {
            "css": "checklist-panel sb-checklist-item"
          }
        },
        {
          "elementName": "panelCloseButton",
          "selector": {
            "css": "checklist-panel button:has(.sr-only:text-is('Close')), checklist-panel button[aria-label='Close']"
          }
        }
      ]
    },
    {
      "name": "SchedulePage",
      "elements": [
        {
          "elementName": "shiftsSidebar",
          "selector": {
            "css": "schedule-dynamic-sidebar-shifts"
          }
        },
        {
          "elementName": "shiftsSidebarToggle",
          "selector": {
            "css": "button[data-tracking-id='schedule-sidebar-toggle']"
          }
        },
        {
          "elementName": "shiftTemplateCard",
          "selector": {
            "css": "schedule-dynamic-sidebar-shifts div[dnd-free-draggable]"
          }
        },
        {
          "elementName": "dayDropZone",
          "selector": {
            "css": "n-period-employee-dropzone-day .day-drop-list"
          }
        },
        {
          "elementName": "scheduledShift",
          "selector": {
            "css": "schedule-shift-template"
          }
        },
        {
          "elementName": "tourStartButton",
          "selector": {
            "role": "button",
            "name": {
              "regex": "Let's do it",
              "flags": "i"
            }
          }
        }
      ]
    },
    {
      "name": "ChecklistDialogPage",
      "elements": [
        {
          "elementName": "dialog",
          "selector": {
            "css": "[role='dialog']"
          }
        },
        {
          "elementName": "closeButton",
          "selector": {
            "css": "[role='dialog'] button:has(.sr-only:text-is('Close')), [role='dialog'] button[aria-label='Close']"
          }
        },
        {
          "elementName": "startQuickSetupButton",
          "selector": {
            "role": "button",
            "name": "Start quick setup"
          }
        },
        {
          "elementName": "showTourButton",
          "selector": {
            "role": "button",
            "name": "Show me a quick tour"
          }
        },
        {
          "elementName": "doneButton",
          "selector": {
            "role": "button",
            "name": "Done!"
          }
        },
        {
          "elementName": "schedulingDefaultsConfirmation",
          "selector": {
            "text": "We've enabled some smart scheduling defaults for you."
          }
        },
        {
          "elementName": "timeTrackingDialog",
          "selector": {
            "css": "time-tracking-dialog"
          }
        },
        {
          "elementName": "timeTrackingQuestion",
          "selector": {
            "text": "Which method of time tracking works best for your team?"
          }
        },
        {
          "elementName": "clockInOption",
          "selector": {
            "css": "time-tracking-dialog label:has-text('Allow employees to clock in and out')"
          }
        },
        {
          "elementName": "nextButton",
          "selector": {
            "role": "button",
            "name": "Next"
          }
        },
        {
          "elementName": "inviteEmployeesDialog",
          "selector": {
            "css": "invite-employees-dialog"
          }
        },
        {
          "elementName": "productTourBanner",
          "selector": {
            "text": "You are viewing a product tour"
          }
        },
        {
          "elementName": "skipTourButton",
          "selector": {
            "role": "button",
            "name": "Skip tour"
          }
        }
      ]
    },
    {
      "name": "AppChromePage",
      "elements": [
        {
          "elementName": "coachMarkPopover",
          "selector": {
            "css": ".cdk-overlay-pane sb-popover"
          }
        },
        {
          "elementName": "coachMarkGotItButton",
          "selector": {
            "role": "button",
            "name": {
              "regex": "^Got it!?$",
              "flags": "i"
            }
          }
        },
        {
          "elementName": "coachMarkActionButton",
          "selector": {
            "css": ".cdk-overlay-pane sb-popover button"
          }
        }
      ]
    }
